{
  "name": "workspace",
  "version": "1.0.0",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "msw",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/risecare-kiosk run dev",
    "prod": "cross-env API_SILENT=1 pnpm --parallel --filter @workspace/api-server --filter @workspace/risecare-kiosk run dev",
    "test": "tsx --test artifacts/api-server/src/sync-sanitize.test.ts artifacts/api-server/src/sensor-calibration.test.ts artifacts/risecare-kiosk/src/lib/vitals-utils.test.ts",
    "dev:local": "pnpm --parallel --filter @workspace/api-server --filter @workspace/risecare-kiosk run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "build:kiosk": "pnpm --filter @workspace/risecare-kiosk run build",
    "start": "pnpm run build:kiosk && pnpm --filter @workspace/api-server run start",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "cross-env": "^10.1.0",
    "lightningcss-linux-arm64-gnu": "^1.32.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
